---
import SiteShell from '../layouts/SiteShell.astro';
import { GUESTBOOK_EMBED, GUESTBOOK_SIGN } from '../lib/ultraguest';
---

<SiteShell title="guestbook - ohrt.dev">
  <div class="guestbook">
    <a class="guestbook-sign" href={GUESTBOOK_SIGN} target="_blank" rel="noopener">
      Sign the guestbook
    </a>
    <div class="guestbook-frame">
      <p class="guestbook-loading">loading the guestbook...</p>
      <iframe src={GUESTBOOK_EMBED} title="Guestbook messages" referrerpolicy="no-referrer"></iframe>
    </div>
  </div>
</SiteShell>

<style>
  :global(.panel-content) {
    display: flex;
    flex-direction: column;
  }

  .guestbook {
    position: relative;
    flex: 1 1 auto;
    min-height: 240px;
    display: flex;
    flex-direction: column;
  }

  .guestbook-sign {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 16px;
    border-radius: 4px;
    background: var(--nav-gradient);
    color: #cfe6ff;
    font-size: 18px;
    font-weight: bold;
    text-decoration: none;
    text-shadow:
      0 0 2px #0b2a8a,
      0 0 4px #0b2a8a;
    box-shadow:
      0 2px 6px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .guestbook-frame {
    --zoom: calc(17.5 / 14);
    position: relative;
    flex: 1 1 0;
    min-height: 0;
    background: #2e4e70;
  }

  .guestbook-loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 15px;
    letter-spacing: 1px;
  }

  .guestbook-loading::after {
    content: '';
    display: inline-block;
    width: 1.4em;
    text-align: left;
    animation: guestbook-dots 1.2s steps(4) infinite;
  }

  @keyframes guestbook-dots {
    to {
      width: 0;
    }
  }

  .guestbook-frame iframe {
    position: absolute;
    inset: 0;
    width: calc(100% / var(--zoom));
    height: calc(100% / var(--zoom));
    border: 0;
    background: transparent;
    transform: scale(var(--zoom));
    transform-origin: 0 0;
  }

  @media (max-width: 1020px) {
    .guestbook {
      min-height: calc(240px / var(--scale));
    }

    .guestbook-sign {
      top: auto;
      right: calc(8px / var(--scale));
      bottom: calc(8px / var(--scale));
      height: calc((34px - 10px * var(--phone)) / var(--scale));
      padding: 0 calc((16px - 7px * var(--phone)) / var(--scale));
      border-radius: calc(4px / var(--scale));
      font-size: calc((18px - 7px * var(--phone)) / var(--scale));
      text-shadow:
        0 0 calc(2px / var(--scale)) #0b2a8a,
        0 0 calc(4px / var(--scale)) #0b2a8a;
    }

    .guestbook-frame {
      --zoom: calc((17.5 - 5.5 * var(--phone)) / 14);
    }

    .guestbook-loading {
      font-size: calc((15px - 4px * var(--phone)) / var(--scale));
      letter-spacing: calc(1px / var(--scale));
    }

    .guestbook-frame iframe {
      width: calc(100% * var(--scale) / var(--zoom));
      height: calc(100% * var(--scale) / var(--zoom));
      transform: scale(calc(var(--zoom) / var(--scale)));
      transform-origin: 0 0;
    }
  }
</style>
