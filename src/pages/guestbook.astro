---
import SiteShell from '../layouts/SiteShell.astro';
import { fetchMessages, GUESTBOOK_URL, when, type Message } from '../lib/guestbook';

let messages: Message[] = [];
let failed = false;
try {
  messages = await fetchMessages();
} catch (err) {
  failed = true;
  console.warn(`[guestbook] ${err}, linking to the book instead`);
}
---

<SiteShell title="guestbook - ohrt.dev">
  <div class="guestbook">
    <p class="guestbook-count">
      {failed
        ? 'the messages did not load this time'
        : `${messages.length} ${messages.length === 1 ? 'message' : 'messages'}`}
    </p>
    <ol class="messages">
      {messages.map((m) => (
        <li class="message">
          <div class="message-head">
            <strong set:html={m.name} />
            <time datetime={new Date(m.time).toISOString()}>{when(m.time)}</time>
          </div>
          <p class="message-text" set:html={m.html} />
          {m.replies.map((r) => (
            <div class="reply">
              <div class="message-head">
                <strong>Oliver replied</strong>
                <time datetime={new Date(r.time).toISOString()}>{when(r.time)}</time>
              </div>
              <p class="message-text" set:html={r.html} />
            </div>
          ))}
        </li>
      ))}
    </ol>
    <p class="guestbook-credit">
      {failed && (
        <>
          <a href={GUESTBOOK_URL} target="_blank" rel="noopener">
            read them on atabook
          </a>
          ,{' '}
        </>
      )}
      powered by{' '}
      <a href="https://atabook.org" target="_blank" rel="noopener">
        atabook
      </a>
    </p>
    <a class="guestbook-sign" href={GUESTBOOK_URL} target="_blank" rel="noopener">
      Sign the guestbook
    </a>
  </div>
</SiteShell>

<style>
  :global(main.panel-center > .panel-content) {
    display: flex;
    flex-direction: column;
    background:
      linear-gradient(rgba(53, 87, 122, 0.8), rgba(53, 87, 122, 0.8)),
      #35577a url('/images/guestbook/background.webp') center top;
  }

  .guestbook {
    position: relative;
    flex: 1 1 auto;
    min-height: 240px;
    display: flex;
    flex-direction: column;
  }

  .guestbook-count {
    margin: 0 0 15px;
  }

  .guestbook-sign {
    position: sticky;
    bottom: 12px;
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    margin: auto -8px -8px 0;
    height: 36px;
    padding: 0 16px;
    border-radius: 4px;
    background: var(--nav-gradient);
    color: #cfe6ff;
    font-size: 18px;
    font-weight: bold;
    text-decoration: none;
    text-shadow:
      0 0 2px #0b2a8a,
      0 0 4px #0b2a8a;
    box-shadow:
      0 2px 6px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .messages {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .message {
    margin-bottom: 10px;
    padding: 5px;
    border: 1px solid #3f6589;
    background: #263e66;
    color: #cfe6ff;
    overflow: hidden;
  }

  .message-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 12px;
  }

  .message-head time {
    white-space: nowrap;
  }

  .message-text {
    margin: 8px 0 5px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .message-text :global(a) {
    color: #cfe6ff;
  }

  .message-text :global(img) {
    vertical-align: middle;
  }

  .reply {
    margin-top: 10px;
    padding: 5px;
    border: 1px solid #000;
    background: #3f6589;
    color: #fff;
  }

  .guestbook-credit {
    margin: 15px 0 0;
    text-align: center;
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
  }

  .guestbook-credit a {
    color: #cfe6ff;
  }

  @media (max-width: 1020px) {
    .guestbook {
      min-height: calc(240px / var(--scale));
    }

    .guestbook-count {
      margin-bottom: calc(10px / var(--scale));
    }

    .guestbook-sign {
      position: absolute;
      right: calc(8px / var(--scale));
      bottom: calc(8px / var(--scale));
      margin: 0;
      height: calc((34px - 10px * var(--phone)) / var(--scale));
      padding: 0 calc((16px - 7px * var(--phone)) / var(--scale));
      border-radius: calc(4px / var(--scale));
      font-size: calc((18px - 7px * var(--phone)) / var(--scale));
      text-shadow:
        0 0 calc(2px / var(--scale)) #0b2a8a,
        0 0 calc(4px / var(--scale)) #0b2a8a;
    }

    .message {
      margin-bottom: calc(8px / var(--scale));
      padding: calc(6px / var(--scale));
      border-width: calc(1px / var(--scale));
    }

    .message-head {
      gap: 0 calc(10px / var(--scale));
    }

    .message-text {
      margin: calc(6px / var(--scale)) 0 calc(4px / var(--scale));
    }

    .message-text :global(img) {
      height: 1.1em;
      width: auto;
    }

    .reply {
      margin-top: calc(8px / var(--scale));
      padding: calc(5px / var(--scale));
      border-width: calc(1px / var(--scale));
    }

    .guestbook-credit {
      margin-top: calc(12px / var(--scale));
      font-size: calc((15px - 4px * var(--phone)) / var(--scale));
    }
  }
</style>
