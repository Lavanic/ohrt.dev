---
import SiteShell from '../layouts/SiteShell.astro';

const ELSEWHERE = [
  { name: 'GitHub', href: 'https://github.com/Lavanic', icon: 'github' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/ohrt', icon: 'linkedin' },
  { name: 'Instagram', href: 'https://www.instagram.com/oliverohrt', icon: 'instagram' },
  { name: 'YouTube', href: 'https://www.youtube.com/@CalicoCoder', icon: 'youtube' },
  { name: 'Spotify', href: 'https://open.spotify.com/user/ollie-ohrt', icon: 'spotify' },
  { name: 'Beli', href: 'https://beliapp.co/app/oliverohrt', icon: 'beli' },
  { name: 'Weblog', href: 'https://blog.ohrt.dev', icon: 'website' },
  { name: 'Email', href: 'mailto:oliver@theohrts.com', icon: 'email' },
];
---

<SiteShell title="links - ohrt.dev" description="Cool stuff + where to find Oliver elsewhere.">
  <div class="links">
    <section class="elsewhere-row">
      <h2 class="section">Find me elsewhere:</h2>
      <ul class="elsewhere">
        {ELSEWHERE.map(({ name, href, icon }) => (
          <li>
            <a href={href} target={href.startsWith('mailto:') ? undefined : '_blank'} rel="me noopener" title={name}>
              <img src={`/icons/social/${icon}@48.webp`} width="48" height="48" alt={name} />
            </a>
          </li>
        ))}
      </ul>
    </section>
    <p class="credit">
      Icons by{' '}
      <a href="https://github.com/paulrobertlloyd/socialmediaicons" target="_blank" rel="noopener">
        Paul Robert Lloyd
      </a>
      .
    </p>
  </div>
</SiteShell>

<style>
  .elsewhere-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  :global(.panel-content) h2.section {
    flex-shrink: 0;
    margin: 0;
    white-space: nowrap;
  }

  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    min-width: 0;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .elsewhere a {
    display: block;
    line-height: 0;
  }

  .elsewhere img {
    display: block;
  }

  .credit {
    margin-top: 2px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 1020px) {
    .elsewhere-row {
      flex-direction: column;
      align-items: flex-start;
      gap: calc(10px / var(--scale));
    }

    :global(.panel-content) h2.section {
      white-space: normal;
    }

    .elsewhere {
      flex-wrap: wrap;
      gap: calc(10px / var(--scale));
    }

    .elsewhere img {
      width: calc((48px - 8px * var(--phone)) / var(--scale));
      height: auto;
    }

    .credit {
      margin-top: calc(4px / var(--scale));
      font-size: calc((12px - 3px * var(--phone)) / var(--scale));
    }
  }
</style>
