---
import { ClientRouter } from 'astro:transitions';
import { GOATCOUNTER } from '../lib/goatcounter';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Oliver's corner of the web." } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/og.jpg', Astro.site);

const identity = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://ohrt.dev/#website',
      name: 'ohrt.dev',
      url: 'https://ohrt.dev/',
      author: { '@id': 'https://ohrt.dev/#me' },
    },
    {
      '@type': 'Person',
      '@id': 'https://ohrt.dev/#me',
      name: 'Oliver Ohrt',
      url: 'https://ohrt.dev/',
      image: 'https://ohrt.dev/images/webmaster.webp',
      sameAs: [
        'https://github.com/Lavanic',
        'https://www.linkedin.com/in/ohrt',
        'https://www.instagram.com/oliverohrt',
        'https://blog.ohrt.dev/',
      ],
    },
  ],
};
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const FOLD_HEIGHT = 1054;
        const PAGE_PADDING = 20;
        const MAX_WIDTH = 0.6;
        const FLOOR = 0.7;
        const PHONE_SHARE = 0.88;
        const html = document.documentElement;
        let width = 0;
        let fit = '';
        const apply = () => {
          html.style.setProperty('--fit', fit);
          html.setAttribute('data-fit', '');
        };
        const measure = () => {
          if (html.clientWidth === width) return;
          width = html.clientWidth;
          const desktop = Math.min((innerHeight - PAGE_PADDING) / FOLD_HEIGHT, (MAX_WIDTH * width) / 960);
          const phone = (PHONE_SHARE * width) / 960;
          fit = (innerWidth > 1020 ? Math.max(FLOOR, desktop) : phone).toFixed(4);
          apply();
        };
        measure();
        addEventListener('resize', measure);
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <!-- Browser chrome color: works on Android Chrome + iOS Safari 15+ for address bar -->
    <meta name="theme-color" content="#202E46" />
    <meta name="color-scheme" content="only light" />
    <meta name="darkreader-lock" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Oliver Ohrt's Weblog"
      href="https://blog.ohrt.dev/rss.xml"
    />
    <link rel="me" href="https://github.com/Lavanic" />
    <meta property="og:site_name" content="ohrt.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ohrt.dev, with gears in place of the two O's" />
    <meta name="twitter:card" content="summary_large_image" />
    {Astro.url.pathname === '/' && <script is:inline type="application/ld+json" set:html={JSON.stringify(identity)} />}
    <link rel="preconnect" href="https://github-contributions-api.jogruber.de" crossorigin />
    <link rel="preconnect" href="https://ws.audioscrobbler.com" crossorigin />
    <link rel="preconnect" href={GOATCOUNTER} crossorigin />
    <!-- background.avif and header.png live in CSS, so without a preload the
         browser only discovers them after the stylesheet is parsed -->
    <link rel="preload" as="image" href="/images/background.avif" type="image/avif" fetchpriority="high" />
    <link rel="preload" as="image" href="/images/header.webp" />
    <link rel="preload" as="image" href="/images/gears_sheet.webp" />
    <style is:inline data-astro-transition-persist="dseg7">
      @font-face {
        font-family: 'DSEG7';
        src: url('/fonts/DSEG7Classic-Bold.woff2') format('woff2');
        font-display: block;
      }
      @font-face {
        font-family: 'Noto Sans';
        src: url('/fonts/NotoSans-Regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Noto Sans';
        src: url('/fonts/NotoSans-Bold.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Noto Sans';
        src: url('/fonts/NotoSans-Italic.woff2') format('woff2');
        font-weight: 400;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: 'Noto Sans';
        src: url('/fonts/NotoSans-BoldItalic.woff2') format('woff2');
        font-weight: 700;
        font-style: italic;
        font-display: swap;
      }
    </style>
    <link rel="preload" as="font" type="font/woff2" href="/fonts/NotoSans-Regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/NotoSans-Bold.woff2" crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/DSEG7Classic-Bold.woff2"
      media="(min-width: 1021px)"
      crossorigin
    />
  </head>
  <body>
    <slot />
    <script is:inline define:vars={{ GOATCOUNTER }}>
      // Analytics show the visitor nothing, so they wait until the page itself has
      // loaded. As plain script tags they held the load event open for up to a second.
      (() => {
        const add = (src, data) => {
          const script = document.createElement('script');
          script.async = true;
          script.src = src;
          Object.assign(script.dataset, data);
          document.head.append(script);
        };
        const start = () =>
          setTimeout(() => {
            // count.js looks for its own script tag on every count, and the router
            // drops injected tags from the head on a page swap. This setting survives.
            window.goatcounter = { endpoint: `${GOATCOUNTER}/count` };
            add('https://gc.zgo.at/count.js');
            add('https://cloud.umami.is/script.js', { websiteId: '02aa9e5f-726b-484a-99f2-e8fdd2e46275' });
          });
        if (document.readyState === 'complete') start();
        else addEventListener('load', start, { once: true });
      })();
    </script>
    <script>
      document.addEventListener('astro:after-swap', () => {
        (window as any).goatcounter?.count?.({ path: location.pathname });
      });

      // The other pages are fetched ahead of a click, but only once this page has
      // everything it needs. Before, they shared the line with its images and fonts.
      // Done by hand because importing astro:prefetch here splits it into one more
      // script file, and every script on the page then waits for that file.
      const warmed = new Set([location.pathname]);
      const warm = () => {
        const connection = (navigator as any).connection;
        if (connection?.saveData || /2g/.test(connection?.effectiveType)) return;
        for (const a of document.querySelectorAll<HTMLAnchorElement>('a[href^="/"]')) {
          if (warmed.has(a.pathname)) continue;
          warmed.add(a.pathname);
          const link = document.createElement('link');
          if (link.relList?.supports?.('prefetch')) {
            link.rel = 'prefetch';
            link.href = a.href;
            document.head.append(link);
          } else {
            fetch(a.href, { priority: 'low' }).catch(() => {});
          }
        }
      };
      const afterLoad = () => setTimeout(warm, 300);
      if (document.readyState === 'complete') afterLoad();
      else addEventListener('load', afterLoad, { once: true });
      document.addEventListener('astro:after-swap', afterLoad);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --gap: 10px;
    --page-padding: 20px;
    --container-width: 960px;
    --border-inner: rgb(0, 15, 149);
    --border-outer: rgb(96, 96, 96);
    /* Shared by the subheader bars and the changelog title */
    --bar-gradient: linear-gradient(to bottom, #b2d1ff 0%, #80a7ff 50%, #3a7ab6 51%, #a8beff 100%);
    /* The left panel's buttons */
    --nav-gradient: linear-gradient(to bottom, #709bdc 0%, #5179d5 50%, #3f5d79 51%, #6a86db 100%);
    /* The stamp bar */
    --stamp-gradient: linear-gradient(to bottom, #f6f2cd 0%, #efeca2 50%, #b6ac37 51%, #f5f5c4 100%);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    overflow-x: hidden;
    overflow-x: clip;
  }

  body {
    position: relative;
    display: flex;
    justify-content: center;
    padding: var(--page-padding);
    background-color: #202e46;
    font-family: 'Noto Sans', sans-serif;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0 0 auto;
    height: 100vh;
    height: 100lvh;
    background-image: url('/images/background.webp');
    background-image: image-set(
      url('/images/background.avif') type('image/avif'),
      url('/images/background.webp') type('image/webp')
    );
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    opacity: 0.6;
    z-index: -1;
  }

  .layout {
    width: var(--container-width);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    --scale: 1;
    transform: scale(var(--scale));
    transform-origin: top center;
    /* The transform does not shrink layout height, so pull the page bottom
       up by the height the scale removed. Same trick the mobile ladder used. */
    margin-bottom: calc((var(--scale) - 1) * 100%);
  }

  .box {
    box-shadow:
      0 0 0 1.5px var(--border-inner),
      0 0 0 3px var(--border-outer);
    background: white;
  }

  /* Utility: add `no-mobile` to any element to hide it once the layout hits
     its first scale-down breakpoint. Will be used for arm lol */
  @media (max-width: 1020px) {
    .no-mobile {
      display: none !important;
    }
  }

  /* ── Desktop scaling ─────────────────────────────────────────────────────
     The design is sized for a 1920px wide screen where 960px fills half the
     viewport. Smaller or high-dpi laptops (a 14in retina MacBook is only
     1512 css px wide) see far fewer css pixels, so the fixed 960px looks
     zoomed in. The fit script in the head measures the real viewport and
     sets --fit so the panels end at the fold on any screen. These steps are
     the fallback for when it has not run.
     Floor of 0.75 so text stays readable on tablets and small windows. */
  @media (max-width: 1919px) {
    .layout {
      --scale: 0.95;
    }
  }
  @media (max-width: 1750px) {
    .layout {
      --scale: 0.9;
    }
  }
  @media (max-width: 1650px) {
    .layout {
      --scale: 0.85;
    }
  }
  @media (max-width: 1550px) {
    .layout {
      --scale: 0.8;
    }
  }
  @media (max-width: 1450px) {
    .layout {
      --scale: 0.75;
    }
  }
  html[data-fit] .layout {
    --scale: var(--fit);
  }

  /* ── Mobile scaling ──────────────────────────────────────────────────────
     The site is fixed-width (960px). Rather than rebuilding the layout,
     we scale the whole thing down like zooming out. Each step only sets
     --scale; the transform and margin compensation live on .layout above.

     --phone is 0 at the breakpoint and 1 once the scale drops under 0.45
     (every iPhone in portrait). SiteShell blends its mobile sizes with it,
     so tablets land between the desktop and the phone look.
  ───────────────────────────────────────────────────────────────────────── */
  @media (max-width: 1020px) {
    .layout {
      --scale: 0.9;
      --phone: clamp(0, (1 - var(--scale)) / 0.55, 1);
    }
  }
  @media (max-width: 900px) {
    .layout {
      --scale: 0.78;
    }
  }
  @media (max-width: 780px) {
    .layout {
      --scale: 0.67;
    }
  }
  @media (max-width: 650px) {
    .layout {
      --scale: 0.56;
    }
  }
  @media (max-width: 540px) {
    .layout {
      --scale: 0.46;
    }
  }
  @media (max-width: 430px) {
    .layout {
      --scale: 0.37;
    }
  }
  @media (max-width: 360px) {
    .layout {
      --scale: 0.31;
    }
  }
</style>
